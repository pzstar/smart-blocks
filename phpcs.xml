<?xml version="1.0"?>
<ruleset name="smart-blocks">
    <description>Coding standards for smart-blocks.</description>

    <file>.</file>

    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/build/*</exclude-pattern>
    <exclude-pattern>/inc/assets/lib/*</exclude-pattern>
    <exclude-pattern>*.min.js</exclude-pattern>
    <!-- Bundled third party font loader. -->
    <exclude-pattern>/inc/wptt-webfont-loader.php</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="ps"/>

    <rule ref="WordPress">
        <!-- The codebase uses 4 space indentation and brace style already. -->
        <exclude name="Generic.WhiteSpace.DisallowSpaceIndent"/>
        <exclude name="WordPress.Files.FileName"/>
        <exclude name="Squiz.Commenting.FileComment"/>
    </rule>

    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array" value="smart_blocks,SMART_BLOCKS,sb_"/>
        </properties>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array" value="smart-blocks"/>
        </properties>
    </rule>

    <config name="minimum_wp_version" value="6.6"/>
    <config name="testVersion" value="7.4-"/>
    <rule ref="PHPCompatibilityWP"/>
</ruleset>
